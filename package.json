{
	"name": "motorcatalog",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test",
		"test:a11y": "node --test \"tests/a11y/*.test.js\"",
		"test:e2e": "node --test \"tests/e2e/*.test.js\"",
		"a11y:scan": "pa11y-ci --config .pa11yci.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"axe-core": "^4.13.0",
		"jsdom": "^30.1.0",
		"pa11y-ci": "^4.1.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.1.0",
		"wait-on": "^9.1.0"
	},
	"allowScripts": {
		"puppeteer@25.12.0": true
	},
	"overrides": {
		"pa11y": "^10.0.0",
		"puppeteer": "^25.12.0"
	},
	"dependencies": {
		"@fontsource/fraunces": "^5.3.0"
	}
}
